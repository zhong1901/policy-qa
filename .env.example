# ===== 复制本文件为 .env 并填真实值 =====

# 数据库（本机 Docker 用 localhost；部署到服务器时改成容器名 db）
DATABASE_URL=postgresql://policy:CHANGE_ME@localhost:5432/policy

# 大模型生成（DeepSeek）
# 可选模型：deepseek-v4-pro（强，慢）/ deepseek-flash（快，便宜）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=deepseek-v4-pro
# 推理模型：reasoning_tokens 会占 max_tokens，给太小会拿到空 content
LLM_MAX_TOKENS=2000
LLM_TIMEOUT=90

# Embedding（1024 维，硅基流动 bge-m3）
# 注意：DeepSeek 没有 embedding 接口，必须用第三方；不填则自动降级为纯关键词检索
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=sk-xxx
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# 检索/生成阈值（可调）
REFUSAL_THRESHOLD=0.30
TOP_K_VECTOR=30
TOP_K_KEYWORD=30
TOP_K_FINAL=5
CITATION_MIN_SIM=0.90

# 前端跨域（本地开发用）
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
